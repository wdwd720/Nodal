# .env.example -- GENERATED by `go test ./internal/config -run TestExampleEnv -update`.
# Do not edit by hand; edit the variable table in internal/config/load.go.
#
# LOCAL developer values only. Never put production secrets in this file, the
# repository, a Docker image or the frontend (goal PART 99). Copy to .env
# (git-ignored) and adjust.
#
# Defaults shown below are applied by Load ONLY when CP_ENV is LOCAL or TEST.
# In DEV, STAGING and PROD every variable marked "required" must be set
# explicitly; a missing value is a startup error, never a silent default.
# STAGING/PROD additionally reject fake providers, dev/debug auth, seeding,
# non-TLS data stores, CORS wildcards, plain-text secrets, and require the
# archive, Object Lock, KMS signing key, secure cookies and https URLs.

# ==== Core ====

# Deployment environment: LOCAL | TEST | DEV | STAGING | PROD. No default; unknown values are
# rejected. Only LOCAL and TEST apply the defaults listed below.
# [required]
CP_ENV=LOCAL

# Service name used in telemetry resource attributes and logs.
# [required outside LOCAL/TEST; LOCAL/TEST default: controlplane]
CP_SERVICE_NAME=controlplane

# Customer-facing product name (brand-neutral codebase; goal PART 5). Must be non-empty in
# STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: Control Plane]
CP_PUBLIC_PRODUCT_NAME="Control Plane"

# ==== HTTP ====

# Listen address for the HTTP API.
# [required outside LOCAL/TEST; LOCAL/TEST default: 127.0.0.1:8080]
CP_HTTP_ADDR=127.0.0.1:8080

# Externally visible base URL (used for redirects and links). Must be https in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: http://127.0.0.1:8080]
CP_HTTP_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Comma-separated allowed CORS origins. "*" is rejected in STAGING/PROD.
# [optional]
CP_HTTP_CORS_ORIGINS=http://localhost:3000

# Server read timeout (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 10s]
CP_HTTP_READ_TIMEOUT=10s

# Server write timeout (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 30s]
CP_HTTP_WRITE_TIMEOUT=30s

# Keep-alive idle timeout (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 120s]
CP_HTTP_IDLE_TIMEOUT=120s

# Maximum accepted request body in bytes.
# [required outside LOCAL/TEST; LOCAL/TEST default: 1048576]
CP_HTTP_MAX_BODY_BYTES=1048576

# Comma-separated CIDRs of load balancers whose X-Forwarded-For is trusted. Empty means trust
# none.
# [optional]
CP_HTTP_TRUSTED_PROXY_CIDRS=

# ==== Database (Postgres) ====

# SecretRef to the application-role Postgres URL (cp_app). Plain value only in LOCAL/TEST.
# [required outside LOCAL/TEST; LOCAL/TEST default: postgres://cp_app:cp_app_local@127.0.0.1:5433/controlplane?sslmode=disable; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_DATABASE_APP_URL=postgres://cp_app:cp_app_local@127.0.0.1:5433/controlplane?sslmode=disable

# SecretRef to the migration-role Postgres URL (cp_migrate). Required only of tooling;
# cmd/migrate reads it from the environment itself, and the internet-facing binary must not be
# given it.
# [required outside LOCAL/TEST; LOCAL/TEST default: postgres://cp_migrate:cp_migrate_local@127.0.0.1:5433/controlplane?sslmode=disable; only required of tooling; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_DATABASE_MIGRATE_URL=postgres://cp_migrate:cp_migrate_local@127.0.0.1:5433/controlplane?sslmode=disable

# SecretRef to the read-only Postgres URL (cp_readonly). Optional; readers fall back to the app
# URL.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_DATABASE_READONLY_URL=

# SecretRef to the operations-role Postgres URL (cp_ops). Optional; the retention passes need
# it, because cp_app holds no DELETE on the rows they remove.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_DATABASE_OPS_URL=postgres://cp_ops:cp_ops_local@127.0.0.1:5433/controlplane?sslmode=disable

# Refuse Postgres connections that are not TLS with certificate verification. Must be true in
# STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false]
CP_DATABASE_REQUIRE_TLS=false

# Maximum pool connections.
# [required outside LOCAL/TEST; LOCAL/TEST default: 10]
CP_DATABASE_MAX_CONNS=10

# Minimum idle pool connections.
# [required outside LOCAL/TEST; LOCAL/TEST default: 1]
CP_DATABASE_MIN_CONNS=1

# How long one dial to Postgres may take. Bounded below the API request timeout on purpose: a
# connect that outlives the request it serves is work done for nobody, holding a pool slot the
# next request wanted.
# [required outside LOCAL/TEST; LOCAL/TEST default: 5s]
CP_DATABASE_CONNECT_TIMEOUT=5s

# Discard a pooled connection idle this long. On a database that suspends when idle -- Neon's
# free tier scales to zero -- a pooled connection outlives the server on the other end of it,
# and a connection failure is not retryable by design. 0 leaves pgxpool's 30-minute default.
# [required outside LOCAL/TEST; LOCAL/TEST default: 0s]
CP_DATABASE_MAX_CONN_IDLE_TIME=0s

# Postgres statement_timeout applied per session.
# [required outside LOCAL/TEST; LOCAL/TEST default: 30s]
CP_DATABASE_STATEMENT_TIMEOUT=30s

# Postgres lock_timeout applied per session.
# [required outside LOCAL/TEST; LOCAL/TEST default: 5s]
CP_DATABASE_LOCK_TIMEOUT=5s

# ==== API (cmd/api only) ====

# Per-request deadline for non-streaming routes (Go duration). Empty takes
# CP_HTTP_WRITE_TIMEOUT.
# [optional; only required of api]
CP_API_REQUEST_TIMEOUT=30s

# Bound on draining in-flight requests before the process exits (Go duration).
# [optional; only required of api]
CP_API_SHUTDOWN_TIMEOUT=25s

# Comma-separated capability names this deployment may run, e.g. CREDIT_PURCHASE. A capability
# absent from the list is inactive whatever its gate row says, and an empty list disables every
# one of them -- which is the default, and fails closed. Being on the list does not activate a
# capability: the gate row still requires three distinct principals.
# [optional; only required of api]
CP_API_ENABLED_CAPABILITIES=CREDIT_PURCHASE

# Chain the funding endpoints quote an onramp on.
# [optional; only required of api]
CP_API_FUNDING_NETWORK=solana

# Currency the funding endpoints quote an onramp in.
# [optional; only required of api]
CP_API_FUNDING_CURRENCY=usdc

# Jurisdiction routing policy to load. The router refuses a development policy outside
# LOCAL/TEST/DEV; naming it here is what lets a configuration check see which one was asked for.
# [optional; only required of api]
CP_API_LEGAL_POLICY=development

# Chain of the USD-pegged asset that funds settle into, e.g. solana. Required in STAGING/PROD;
# cmd/api also checks the pair resolves to a known stablecoin, which needs the database and so
# stays there.
# [optional; only required of api]
CP_API_SETTLEMENT_CHAIN=solana

# Mint address of that asset. Required in STAGING/PROD.
# [optional; only required of api]
CP_API_SETTLEMENT_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ==== Capacity ceilings ====

# Most accounts this deployment tier will hold. Reached, it refuses to open more. 0 disables the
# ceiling, which is only correct where the tier has no such limit.
# [required outside LOCAL/TEST; LOCAL/TEST default: 50; only required of api]
CP_CAPACITY_MAX_ACCOUNTS=50

# Most Credit purchases in any rolling 24 hours. It bounds provider webhook volume and database
# growth together. 0 disables it.
# [required outside LOCAL/TEST; LOCAL/TEST default: 200; only required of api]
CP_CAPACITY_MAX_PURCHASES_PER_DAY=200

# Most money, in minor units, that may sit in a non-terminal funding state at once. This is the
# ceiling that bounds what a failure COSTS rather than what it consumes. 0 disables it.
# [required outside LOCAL/TEST; LOCAL/TEST default: 200000; only required of api]
CP_CAPACITY_MAX_AT_RISK_MINOR=200000

# The database storage quota this tier is subject to. New financial actions stop below it,
# leaving room to reconcile and export. 0 disables it, which is correct on infrastructure with
# no quota.
# [required outside LOCAL/TEST; LOCAL/TEST default: 524288000; only required of api]
CP_CAPACITY_MAX_DATABASE_BYTES=524288000

# ==== Rate limiting ====

# How many processes of this binary serve HTTP. It decides whether process-local rate-limit
# counters can enforce the configured limit: one process can, more cannot, because each keeps
# its own copy of the budget. Whatever runs the deployment -- a task count, a replica count, an
# instance count -- must agree with this, and a value that understates it produces a limit
# looser than the one configured.
# [required outside LOCAL/TEST; LOCAL/TEST default: 1; only required of api]
CP_HTTP_REPLICAS=1

# Transport budget for ordinary requests, as "<requests>/<window>" (e.g. 600/1m) or "off".
# Refused as off in STAGING/PROD: switching a transport limit off is a load-testing affordance,
# never a production one.
# [required outside LOCAL/TEST; LOCAL/TEST default: 600/1m; only required of api]
CP_API_RATE_LIMIT_GENERAL=600/1m

# Transport budget for the authentication routes. Lower than the general one on purpose: these
# are the routes a credential-stuffing run uses.
# [required outside LOCAL/TEST; LOCAL/TEST default: 30/1m; only required of api]
CP_API_RATE_LIMIT_AUTH=30/1m

# Transport budget for quote requests.
# [required outside LOCAL/TEST; LOCAL/TEST default: 120/1m; only required of api]
CP_API_RATE_LIMIT_QUOTE=120/1m

# Transport budget for the routes that change something.
# [required outside LOCAL/TEST; LOCAL/TEST default: 120/1m; only required of api]
CP_API_RATE_LIMIT_COMMAND=120/1m

# Where transport rate-limit counters live: memory | redis. memory keeps them in the process, so
# the budget is per replica -- three API tasks with a limit of 100 admit 300 -- which is why
# STAGING and PROD refuse it. redis shares one budget across every replica and makes CP_REDIS_*
# required of the API.
# [required outside LOCAL/TEST; LOCAL/TEST default: memory; only required of api]
CP_RATELIMIT_BACKEND=memory

# ==== Redis ====

# SecretRef to the Redis URL (may embed a password). Redis is never financial truth.
# [required outside LOCAL/TEST; LOCAL/TEST default: redis://127.0.0.1:6380/0; only required of a service that uses redis; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_REDIS_URL=redis://127.0.0.1:6380/0

# Require rediss:// (TLS). Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false; only required of a service that uses redis]
CP_REDIS_REQUIRE_TLS=false

# ==== Redpanda (event bus) ====

# Comma-separated Kafka-protocol broker addresses.
# [required outside LOCAL/TEST; LOCAL/TEST default: 127.0.0.1:19092; only required of a service that uses redpanda]
CP_REDPANDA_BROKERS=127.0.0.1:19092

# Require TLS to brokers. Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false; only required of a service that uses redpanda]
CP_REDPANDA_REQUIRE_TLS=false

# SASL mechanism (e.g. SCRAM-SHA-256, SCRAM-SHA-512). Empty disables SASL.
# [optional; only required of a service that uses redpanda]
CP_REDPANDA_SASL_MECHANISM=

# SecretRef to the SASL username. Required when a SASL mechanism is set.
# [optional; only required of a service that uses redpanda; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_REDPANDA_SASL_USERNAME_REF=

# SecretRef to the SASL password. Required when a SASL mechanism is set.
# [optional; only required of a service that uses redpanda; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_REDPANDA_SASL_PASSWORD_REF=

# ==== ClickHouse (analytics) ====

# ClickHouse host:port.
# [required outside LOCAL/TEST; LOCAL/TEST default: 127.0.0.1:18123; only required of a service that uses clickhouse]
CP_CLICKHOUSE_ADDR=127.0.0.1:18123

# ClickHouse database name.
# [required outside LOCAL/TEST; LOCAL/TEST default: controlplane; only required of a service that uses clickhouse]
CP_CLICKHOUSE_DATABASE=controlplane

# SecretRef to the ClickHouse username.
# [optional; only required of a service that uses clickhouse; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_CLICKHOUSE_USERNAME_REF=cp

# SecretRef to the ClickHouse password.
# [optional; only required of a service that uses clickhouse; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_CLICKHOUSE_PASSWORD_REF=cp_local

# Require TLS to ClickHouse. Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false; only required of a service that uses clickhouse]
CP_CLICKHOUSE_REQUIRE_TLS=false

# ==== Temporal (workflows) ====

# Temporal frontend host:port.
# [required outside LOCAL/TEST; LOCAL/TEST default: 127.0.0.1:7233; only required of a service that uses temporal]
CP_TEMPORAL_HOST_PORT=127.0.0.1:7233

# Temporal namespace.
# [required outside LOCAL/TEST; LOCAL/TEST default: default; only required of a service that uses temporal]
CP_TEMPORAL_NAMESPACE=default

# Prefix for every task queue name (lets environments share a cluster safely).
# [required outside LOCAL/TEST; LOCAL/TEST default: cp; only required of a service that uses temporal]
CP_TEMPORAL_TASK_QUEUE_PREFIX=cp

# Require TLS to Temporal. Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false; only required of a service that uses temporal]
CP_TEMPORAL_REQUIRE_TLS=false

# ==== Archive (S3-compatible evidence/audit storage) ====

# Where evidence objects live: s3 | postgres. s3 makes every CP_ARCHIVE_* value below required
# and is what a deployment with object storage uses. postgres keeps objects in the application
# database, write-once by privilege and by trigger, and needs no object store at all -- but it
# cannot provide S3 Object Lock, so the audit chain still wants s3.
# [required outside LOCAL/TEST; LOCAL/TEST default: s3; only required of a service that uses archive]
CP_ARCHIVE_BACKEND=s3

# S3-compatible endpoint URL. Empty in AWS means the regional default; LOCAL points at MinIO.
# [required outside LOCAL/TEST; LOCAL/TEST default: http://127.0.0.1:9100; only required of a service that uses archive]
CP_ARCHIVE_ENDPOINT=http://127.0.0.1:9100

# S3 region.
# [required outside LOCAL/TEST; LOCAL/TEST default: us-east-1; only required of a service that uses archive]
CP_ARCHIVE_REGION=us-east-1

# Bucket for raw provider/market payloads.
# [required outside LOCAL/TEST; LOCAL/TEST default: raw-events; only required of a service that uses archive]
CP_ARCHIVE_RAW_BUCKET=raw-events

# Bucket for provider evidence (requests/responses, receipts).
# [required outside LOCAL/TEST; LOCAL/TEST default: provider-evidence; only required of a service that uses archive]
CP_ARCHIVE_EVIDENCE_BUCKET=provider-evidence

# WORM bucket for the audit chain. Object Lock must be enabled in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: audit-evidence; only required of a service that uses archive]
CP_ARCHIVE_AUDIT_BUCKET=audit-evidence

# Refuse to start unless the audit bucket has Object Lock. Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false; only required of a service that uses archive]
CP_ARCHIVE_OBJECT_LOCK_REQUIRED=false

# Use path-style S3 addressing (needed for MinIO).
# [required outside LOCAL/TEST; LOCAL/TEST default: true; only required of a service that uses archive]
CP_ARCHIVE_FORCE_PATH_STYLE=true

# SecretRef to a static S3 access key. Leave empty in AWS to use the task IAM role (preferred;
# goal PART 99).
# [optional; only required of a service that uses archive; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_ARCHIVE_ACCESS_KEY_REF=cp_minio

# SecretRef to a static S3 secret key. Leave empty in AWS to use the task IAM role.
# [optional; only required of a service that uses archive; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_ARCHIVE_SECRET_KEY_REF=cp_minio_local

# ==== KMS ====

# KMS key id/ARN used to sign audit records. Required in STAGING/PROD of the binary that signs,
# which is cmd/audit-worker alone.
# [optional; only required of a service that uses kms]
CP_KMS_AUDIT_SIGNING_KEY_ID=

# KMS region. Required when a signing key is set.
# [optional; only required of a service that uses kms]
CP_KMS_REGION=

# ==== Auth ====

# Authentication mode: oidc | dev. dev is rejected in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: dev]
CP_AUTH_MODE=dev

# OIDC issuer URL. Required when CP_AUTH_MODE=oidc; https in STAGING/PROD.
# [optional]
CP_AUTH_ISSUER=

# OIDC client id. Required when CP_AUTH_MODE=oidc.
# [optional]
CP_AUTH_CLIENT_ID=

# SecretRef to the OIDC client secret. Required when CP_AUTH_MODE=oidc.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_AUTH_CLIENT_SECRET_REF=

# OIDC redirect URL. Required when CP_AUTH_MODE=oidc; https in STAGING/PROD.
# [optional]
CP_AUTH_REDIRECT_URL=

# Session cookie name.
# [required outside LOCAL/TEST; LOCAL/TEST default: cp_session]
CP_AUTH_COOKIE_NAME=cp_session

# Session cookie Domain attribute. Empty means host-only.
# [optional]
CP_AUTH_COOKIE_DOMAIN=

# Set the Secure attribute on session cookies. Must be true in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false]
CP_AUTH_COOKIE_SECURE=false

# Session lifetime (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 12h]
CP_AUTH_SESSION_TTL=12h

# Maximum age of an MFA/passkey authentication for step-up protected actions (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 5m]
CP_AUTH_STEP_UP_MAX_AGE=5m

# Enable debug authentication endpoints. Must be false in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false]
CP_AUTH_DEBUG_ENABLED=false

# ==== Providers ====

# Mode of the credit purchase provider: fake | sandbox | live. fake is rejected in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: fake]
CP_PROVIDER_CREDIT_PURCHASE_MODE=fake

# Adapter name of the credit purchase provider (e.g. the vendor). Required unless mode is fake.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_NAME=

# Base URL of the credit purchase provider API. Optional.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_BASE_URL=

# SecretRef to the credit purchase provider API key.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_CREDIT_PURCHASE_API_KEY_REF=

# SecretRef to the credit purchase provider webhook signing secret.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_CREDIT_PURCHASE_WEBHOOK_SECRET_REF=

# Per-call timeout for the credit purchase provider (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 10s]
CP_PROVIDER_CREDIT_PURCHASE_TIMEOUT=10s

# Provider-side account or tenant id for the credit purchase provider (e.g. a Stripe acct_...).
# Asserted at startup against the account the credentials actually belong to, so a key rotated
# to the wrong account is caught before it moves money.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_ACCOUNT_REF=

# Whether the credit purchase provider account also serves systems outside this deployment. It
# is a declaration for operators and for the capability report; rejecting another product's
# events is unconditional in the adapters that can receive them, so this flag is never the thing
# that makes that safe. Absent means not shared.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_SHARED_ACCOUNT=false

# How far the credit purchase integration is actually approved for use on this account, as
# opposed to how finished the code is. Empty means nothing has been granted, which every adapter
# treats as a refusal.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_AVAILABILITY=

# The static descriptor the credit purchase provider's account puts on a customer's statement,
# e.g. a card statement prefix. It is used to check that the dynamic suffix fits the provider's
# length limit, because a provider that truncates rather than refuses ships a descriptor nobody
# chose.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_DESCRIPTOR_PREFIX=

# What this product should be called on a customer's statement. Required when the provider
# account is shared: a charge that shows another product's name is a charge a customer disputes.
# [optional]
CP_PROVIDER_CREDIT_PURCHASE_DESCRIPTOR_SUFFIX=

# Mode of the payout provider: fake | sandbox | live. fake is rejected in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: fake]
CP_PROVIDER_PAYOUT_MODE=fake

# Adapter name of the payout provider (e.g. the vendor). Required unless mode is fake.
# [optional]
CP_PROVIDER_PAYOUT_NAME=

# Base URL of the payout provider API. Optional.
# [optional]
CP_PROVIDER_PAYOUT_BASE_URL=

# SecretRef to the payout provider API key.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_PAYOUT_API_KEY_REF=

# SecretRef to the payout provider webhook signing secret.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_PAYOUT_WEBHOOK_SECRET_REF=

# Per-call timeout for the payout provider (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 10s]
CP_PROVIDER_PAYOUT_TIMEOUT=10s

# Provider-side account or tenant id for the payout provider (e.g. a Stripe acct_...). Asserted
# at startup against the account the credentials actually belong to, so a key rotated to the
# wrong account is caught before it moves money.
# [optional]
CP_PROVIDER_PAYOUT_ACCOUNT_REF=

# Whether the payout provider account also serves systems outside this deployment. It is a
# declaration for operators and for the capability report; rejecting another product's events is
# unconditional in the adapters that can receive them, so this flag is never the thing that
# makes that safe. Absent means not shared.
# [optional]
CP_PROVIDER_PAYOUT_SHARED_ACCOUNT=false

# How far the payout integration is actually approved for use on this account, as opposed to how
# finished the code is. Empty means nothing has been granted, which every adapter treats as a
# refusal.
# [optional]
CP_PROVIDER_PAYOUT_AVAILABILITY=

# The static descriptor the payout provider's account puts on a customer's statement, e.g. a
# card statement prefix. It is used to check that the dynamic suffix fits the provider's length
# limit, because a provider that truncates rather than refuses ships a descriptor nobody chose.
# [optional]
CP_PROVIDER_PAYOUT_DESCRIPTOR_PREFIX=

# What this product should be called on a customer's statement. Required when the provider
# account is shared: a charge that shows another product's name is a charge a customer disputes.
# [optional]
CP_PROVIDER_PAYOUT_DESCRIPTOR_SUFFIX=

# Mode of the funding provider: fake | sandbox | live. fake is rejected in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: fake]
CP_PROVIDER_FUNDING_MODE=fake

# Adapter name of the funding provider (e.g. the vendor). Required unless mode is fake.
# [optional]
CP_PROVIDER_FUNDING_NAME=

# Base URL of the funding provider API. Optional.
# [optional]
CP_PROVIDER_FUNDING_BASE_URL=

# SecretRef to the funding provider API key.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_FUNDING_API_KEY_REF=

# SecretRef to the funding provider webhook signing secret.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_FUNDING_WEBHOOK_SECRET_REF=

# Per-call timeout for the funding provider (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 10s]
CP_PROVIDER_FUNDING_TIMEOUT=10s

# Provider-side account or tenant id for the funding provider (e.g. a Stripe acct_...). Asserted
# at startup against the account the credentials actually belong to, so a key rotated to the
# wrong account is caught before it moves money.
# [optional]
CP_PROVIDER_FUNDING_ACCOUNT_REF=

# Whether the funding provider account also serves systems outside this deployment. It is a
# declaration for operators and for the capability report; rejecting another product's events is
# unconditional in the adapters that can receive them, so this flag is never the thing that
# makes that safe. Absent means not shared.
# [optional]
CP_PROVIDER_FUNDING_SHARED_ACCOUNT=false

# How far the funding integration is actually approved for use on this account, as opposed to
# how finished the code is. Empty means nothing has been granted, which every adapter treats as
# a refusal.
# [optional]
CP_PROVIDER_FUNDING_AVAILABILITY=

# The static descriptor the funding provider's account puts on a customer's statement, e.g. a
# card statement prefix. It is used to check that the dynamic suffix fits the provider's length
# limit, because a provider that truncates rather than refuses ships a descriptor nobody chose.
# [optional]
CP_PROVIDER_FUNDING_DESCRIPTOR_PREFIX=

# What this product should be called on a customer's statement. Required when the provider
