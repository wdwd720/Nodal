CP_PROVIDER_NOTIFICATION_AVAILABILITY=

# The static descriptor the notification provider's account puts on a customer's statement, e.g.
# a card statement prefix. It is used to check that the dynamic suffix fits the provider's
# length limit, because a provider that truncates rather than refuses ships a descriptor nobody
# chose.
# [optional]
CP_PROVIDER_NOTIFICATION_DESCRIPTOR_PREFIX=

# What this product should be called on a customer's statement. Required when the provider
# account is shared: a charge that shows another product's name is a charge a customer disputes.
# [optional]
CP_PROVIDER_NOTIFICATION_DESCRIPTOR_SUFFIX=

# ==== Telemetry ====

# OTLP gRPC collector host:port. Empty installs no-op tracer/meter providers.
# [optional]
CP_TELEMETRY_OTLP_ENDPOINT=

# Export OTLP without TLS. Ignored (rejected) in PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: true]
CP_TELEMETRY_OTLP_INSECURE=true

# Trace sampling probability as a decimal string in [0,1] (e.g. 1, 0.1). Converted to a float
# only inside the sampler; this is telemetry, not money.
# [required outside LOCAL/TEST; LOCAL/TEST default: 1]
CP_TELEMETRY_TRACE_SAMPLE_RATIO=1

# Metric export interval (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 30s]
CP_TELEMETRY_METRICS_INTERVAL=30s

# ==== Alerting ====

# Where a raised alert is POSTed as JSON. Empty means alerts are logged and delivered nowhere,
# which is said at startup rather than assumed. A SecretRef because a Slack or Discord webhook
# URL is itself the credential.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_ALERT_WEBHOOK_URL=https://hooks.example.test/services/AAA/BBB/CCC

# Payload shape the destination accepts: auto, generic, slack, discord or ntfy. Slack and
# Discord refuse a body that is not their own shape with a 400, so a wrong value here is a
# destination that rejects every alert. auto derives it from the URL's host and is right for
# hooks.slack.com, discord.com and ntfy.sh; name it explicitly for a self-hosted ntfy or a
# Mattermost hook.
# [required outside LOCAL/TEST; LOCAL/TEST default: auto]
CP_ALERT_WEBHOOK_FORMAT=auto

# Lowest severity worth delivering: SEV1 or SEV2. SEV2 delivers everything.
# [required outside LOCAL/TEST; LOCAL/TEST default: SEV2]
CP_ALERT_MIN_SEVERITY=SEV2

# Bound on one delivery attempt. Short on purpose: delivery runs behind a small queue and a slow
# destination delays every alert behind it.
# [required outside LOCAL/TEST; LOCAL/TEST default: 5s]
CP_ALERT_TIMEOUT=5s

# ==== Personal data ====

# Keyring for personal data at rest, as a JSON document: {"active": N, "keys": {"N": "<base64 32
# bytes>"}}. internal/pii seals identity_pii's columns with AES-256-GCM under the active version
# and opens a row under whichever version it names, so rotation is: add a key, make it active,
# deploy, reseal, then remove the old key. Required in STAGING/PROD. Empty in LOCAL/TEST means
# no personal data is stored, which is said at startup. A SecretRef because it IS the key.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PII_KEYRING=env://NODAL_PII_KEYRING

# ==== Seed ====

# Allow seeding clearly-labeled fake users/assets/balances. Must be false in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: false]
CP_SEED_ENABLED=false

# ==== Credit (funding lifecycle) ====

# How long a captured card payment stays reversible before its Credits may be treated as
# settled. A risk determination, not a default worth trusting: card scheme chargeback windows
# run to 120 days.
# [required outside LOCAL/TEST; LOCAL/TEST default: 720h]
CP_CREDIT_SETTLEMENT_WINDOW=720h

# ==== Retention (days per retention class) ====

# Days a login_attempts row is kept after it expired. It holds a plaintext OIDC nonce and PKCE
# verifier; the durable record of a login is a security_events row. Minimum 1.
# [required outside LOCAL/TEST; LOCAL/TEST default: 2]
CP_RETENTION_LOGIN_ATTEMPT_DAYS=2

# Days a monthly partition of security_events is kept before it is detached and dropped. 0
# disables pruning entirely, which is the default because ADR-0020 leaves the period open; when
# set it must be at least 90.
# [required outside LOCAL/TEST; LOCAL/TEST default: 0]
CP_RETENTION_SECURITY_EVENT_DAYS=0

# Retention of the FINANCIAL_RECORD class. Must be > 0 in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: 2555]
CP_RETENTION_FINANCIAL_RECORD_DAYS=2555

# Retention of the SECURITY_AUDIT class. Must be > 0 in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: 2555]
CP_RETENTION_SECURITY_AUDIT_DAYS=2555

# Retention of the RAW_MARKET_DATA class.
# [required outside LOCAL/TEST; LOCAL/TEST default: 90]
CP_RETENTION_RAW_MARKET_DATA_DAYS=90

# Retention of the SOCIAL_DATA class.
# [required outside LOCAL/TEST; LOCAL/TEST default: 30]
CP_RETENTION_SOCIAL_DATA_DAYS=30

# Retention of the MODEL_IO class (prompts, tool calls, model outputs).
# [required outside LOCAL/TEST; LOCAL/TEST default: 90]
CP_RETENTION_MODEL_IO_DAYS=90

# Retention of the OPERATIONAL_LOG class.
# [required outside LOCAL/TEST; LOCAL/TEST default: 30]
CP_RETENTION_OPERATIONAL_LOG_DAYS=30
