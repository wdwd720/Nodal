# Mode of the wallet provider: fake | sandbox | live. fake is rejected in STAGING/PROD.
# [required outside LOCAL/TEST; LOCAL/TEST default: fake]
CP_PROVIDER_WALLET_MODE=fake

# Adapter name of the wallet provider (e.g. the vendor). Required unless mode is fake.
# [optional]
CP_PROVIDER_WALLET_NAME=

# Base URL of the wallet provider API. Optional.
# [optional]
CP_PROVIDER_WALLET_BASE_URL=

# SecretRef to the wallet provider API key.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_WALLET_API_KEY_REF=

# SecretRef to the wallet provider webhook signing secret.
# [optional; SecretRef (env://NAME | aws-sm://name-or-arn | file://path | plain in LOCAL/TEST)]
CP_PROVIDER_WALLET_WEBHOOK_SECRET_REF=

# Per-call timeout for the wallet provider (Go duration).
# [required outside LOCAL/TEST; LOCAL/TEST default: 10s]
CP_PROVIDER_WALLET_TIMEOUT=10s

# Provider-side account or tenant id for the wallet provider (e.g. a Stripe acct_...). Asserted
# at startup against the account the credentials actually belong to, so a key rotated to the
# wrong account is caught before it moves money.
# [optional]
CP_PROVIDER_WALLET_ACCOUNT_REF=

# Whether the wallet provider account also serves systems outside this deployment. It is a
# declaration for operators and for the capability report; rejecting another product's events is
# unconditional in the adapters that can receive them, so this flag is never the thing that
# makes that safe. Absent means not shared.
# [optional]
CP_PROVIDER_WALLET_SHARED_ACCOUNT=false

# How far the wallet integration is actually approved for use on this account, as opposed to how
# finished the code is. Empty means nothing has been granted, which every adapter treats as a
# refusal.
# [optional]
CP_PROVIDER_WALLET_AVAILABILITY=

