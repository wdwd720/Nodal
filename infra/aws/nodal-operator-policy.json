{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BecomeTheDeploymentRoleAndNothingElse",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::049286562577:role/nodal-terraform",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    },
    {
      "Sid": "SeeAndManageOnlyItsOwnMFADevice",
      "Effect": "Allow",
      "Action": [
        "iam:ChangePassword",
        "iam:CreateVirtualMFADevice",
        "iam:DeleteVirtualMFADevice",
        "iam:EnableMFADevice",
        "iam:GetUser",
        "iam:ListMFADevices",
        "iam:ResyncMFADevice"
      ],
      "Resource": [
        "arn:aws:iam::049286562577:user/${aws:username}",
        "arn:aws:iam::049286562577:mfa/${aws:username}"
      ]
    }
  ]
}
