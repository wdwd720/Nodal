# Copy to backend.hcl (git-ignored) and pass with: terraform init -backend-config=backend.hcl
bucket       = "cp-staging-terraform-state-123456789012-us-east-1"
key          = "environments/staging/terraform.tfstate"
region       = "us-east-1"
kms_key_id   = "arn:aws:kms:us-east-1:123456789012:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
