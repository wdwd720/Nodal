{
  "name": "@controlplane/generated-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.yaml -o src/schema.d.ts --alphabetize --empty-objects-unknown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.14.0"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3"
  }
}
